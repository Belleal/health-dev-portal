        "./editing": "./store/editing.js",
        "./files": "./store/files.js",
        "./manifest": "./load/manifest.js",
        "./migration": "./load/migration.js",
        "./moves": "./store/moves.js",
        "./promotion": "./store/promotion.js",
        "./releases": "./store/releases.js",
        "./resolution": "./store/resolution.js",
        "./review": "./store/review.js",
        "./schema": "./store/schema.js",
        "./targets": "./store/targets.js",
        "./versions": "./store/versions.js"
    },
    "imports": {
