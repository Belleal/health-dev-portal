# The portal's environment for `npm start --workspace packages/portal`. Copy this file to packages/portal/.env, which git
# ignores. Core's start-instance reads it from the working directory, packages/portal, and never overrides a variable the
# shell already has: a stale `export` in the shell silently wins over this file.

# The class core's start-instance constructs, relative to packages/portal; the instance is named after the file.
TI_INSTANCE_CLASS=bin/portal-server.js

# Where every page is read from (required): sqlite:<path> or postgres://user@host:5432/database. A URL with a password
# belongs in the deployment's secret store, never in a file. This is a copy of the test seed (see the README).
HDP_DATABASE_URL=sqlite:../../.fixtures/portal-dev/seed.sqlite

# The file store, by content hash: the blueprint catalogue and the fixed downloads. Default: .files under packages/portal.
HDP_FILES_DIR=../../.fixtures/portal-dev/files

# The public origin every absolute link is written from (required): canonical addresses, hreflang, feeds.
TI_WEB_PUBLIC_URL=http://localhost:3000

# Plain HTTP on this machine; in a deployment TLS ends in front of the container (design record §10.4).
TI_WEB_USE_TLS=false
TI_WEB_HOST=127.0.0.1
TI_WEB_PORT=3000

# No sign-in until plan 9 brings the staff area. Empty enables no method; the framework's default enables two.
TI_WEB_AUTH_METHODS=

# One instance: no service mesh to exchange messages with, nothing watching a heartbeat, no scheduled jobs.
TI_MESSAGE_EXCHANGE_ENABLED=false
TI_SERVICE_HEALTH_CHECK_ENABLED=false
TI_WEB_JOBS_TRIGGER=off

# The framework's cache. Measured: without a Redis the start never completes (see the README).
TI_MEMORY_CACHE_REDIS_HOST=127.0.0.1
TI_MEMORY_CACHE_REDIS_PORT=6379

# Calendar days in Sofia (design record §7.12).
TI_LOCALIZATION_TIME_ZONE=Europe/Sofia
